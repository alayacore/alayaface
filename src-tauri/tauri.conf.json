{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "alayaface",
  "version": "0.1.0",
  "identifier": "org.alayacore.alayaface",
  "build": {
    "frontendDist": "../src-elm"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "alayaface",
        "width": 1400,
        "height": 950,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
